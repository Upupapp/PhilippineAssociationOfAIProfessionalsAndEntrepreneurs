# Playwright, installed per-machine. Never published.
# NO trailing slash: node_modules here is often a SYMLINK to a shared install,
# and "tests/node_modules/" does not match a symlink - it was committed once
# because of exactly that.
tests/node_modules
tests/package*.json

# Firestore rules emulator suite: deps and emulator artifacts are per-machine.
tests/emulator/node_modules
tests/emulator/package*.json
tests/emulator/*-debug.log
tests/emulator/firebase-export-*
