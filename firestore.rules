rules_version = '2';

// PAAIPE rules for the SHARED Firebase project "PAAIPE and POSTFLOW"
// (postflowit-autos).
//
// THIS RULESET GOVERNS THE `paaipe` DATABASE ONLY.
//
// PAAIPE has its own Firestore database — `paaipe`, in asia-southeast1
// (Singapore) — created 2026-09-16 with delete protection and point-in-time
// recovery enabled. The project's `(default)` database is a separate database in
// nam5 (United States) with its own, separate ruleset; nothing here touches it.
//
// That separation is deliberate. The Firebase project is shared with PostFlow,
// and one database per product means one ruleset per product: a mistake in these
// rules cannot expose PostFlow's data, and vice versa. It also keeps Philippine
// members' personal data in-region, which matters under RA 10173.
//
// Deploy with:  firebase deploy --only firestore:rules --project postflowit-autos
// (firebase.json targets the `paaipe` database explicitly.)
//
// Every PAAIPE collection is prefixed `paaipe_` so the two products' rules never
// overlap. The default at the bottom denies everything not explicitly allowed.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // PostFlow has no Firestore data as of 2026-09-16, so there is nothing to
    // merge. If that changes, its rules go here, unchanged, before deploying.
    // ---------------------------------------------------------------

    // --- PAAIPE: who is an administrator --------------------------
    // Stated HERE, in the ruleset, and nowhere else.
    //
    // A ruleset is the only file in this project that a client cannot write and
    // only a project owner can deploy, which makes it the one safe place to keep
    // an authorisation list. The alternatives are worse: a Firestore document
    // saying "I am an admin" has to be protected by a rule anyway, and a flag in
    // the page's JavaScript protects nothing at all - anyone can edit it in their
    // own browser. Custom claims on the ID token are the better mechanism at
    // scale and need no rules deploy to change; they require the Admin SDK, which
    // needs service-account credentials this project does not yet have.
    //
    // To add or remove an administrator: edit this list and run
    //   firebase deploy --only firestore:rules --project postflowit-autos
    //
    // NOTE: the project is SHARED with PostFlow. This list authorises access to
    // PAAIPE data only. It says nothing about PostFlow's database, which has its
    // own separate ruleset.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email.lower() in [
               'admin@upupapp.asia'
             ];
    }

    // --- PAAIPE: event registrations ------------------------------
    // Anyone may create one. Only an administrator may read them, and nobody
    // may edit or delete one from a client: these are other people's personal
    // data (RA 10173).
    match /paaipe_event_registrations/{id} {
      allow create: if isWellFormedRegistration(request.resource.data);
      // An administrator may read them - this is what /admin is for. Everyone
      // else, including the person who submitted one, is refused: these are
      // other people's personal data (RA 10173).
      allow read: if isAdmin();
      // An administrator may record what HAPPENED to a registration - attended,
      // cancelled, a note - and may not touch a single word the registrant
      // wrote. That distinction is the whole point: administrative facts are
      // ours to record, their answers are theirs. affectedKeys().hasOnly() is
      // what enforces it, so no console screen can quietly widen it.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         // eventId is an ADMINISTRATIVE fact - which event this
                         // registration belongs to - not a word the registrant
                         // wrote, so an administrator may set it to link up the
                         // rows written before registrations carried one.
                         .hasOnly(['status','attended_at','cancelled_at','admin_note','updated_by','eventId'])
                    && request.resource.data.status in
                         ['registered','attended','no_show','cancelled']
                    && (!('admin_note' in request.resource.data.keys())
                        || (request.resource.data.admin_note is string
                            && request.resource.data.admin_note.size() <= 500))
                    // who did it, stamped from the token rather than supplied
                    && (request.resource.data.get('updated_by', null)
                          == resource.data.get('updated_by', null)
                        || request.resource.data.updated_by == request.auth.token.email);

      // Nobody DELETES a registration, admins included. A record of what
      // someone submitted is not something to make disappear; cancelling sets
      // a status and leaves the record intact.
      allow delete: if false;
    }

    function isWellFormedRegistration(d) {
      return d.keys().hasAll(['event','full_name','email','consent','createdAt'])
          && d.keys().size() <= 20
          // consent is REQUIRED and must be a real boolean true, not "yes"
          && d.consent == true
          && d.event is string      && d.event.size()      > 0   && d.event.size()      <= 120
          && d.full_name is string  && d.full_name.size()  > 0   && d.full_name.size()  <= 120
          && d.email is string      && d.email.size()      > 4   && d.email.size()      <= 254
          && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && (!('position' in d.keys())         || (d.position is string         && d.position.size()         <= 160))
          && (!('organization' in d.keys())     || (d.organization is string     && d.organization.size()     <= 160))
          && (!('profile' in d.keys())          || (d.profile is string          && d.profile.size()          <= 60))
          && (!('profile_other' in d.keys())    || (d.profile_other is string    && d.profile_other.size()    <= 160))
          && (!('learn' in d.keys())            || (d.learn is string            && d.learn.size()            <= 2000))
          && (!('speaker_question' in d.keys()) || (d.speaker_question is string && d.speaker_question.size() <= 2000))
          && (!('source' in d.keys())           || (d.source is string           && d.source.size()           <= 120))
          // Which EVENT this is for. The original design carried only a typed
          // title, which does not reliably match any event record - so a
          // per-event list built on it shows nothing. This is the link.
          && (!('eventId' in d.keys())          || (d.eventId is string          && d.eventId.size()          <= 120))
          && (!('updates' in d.keys())          || d.updates is bool)
          && (!('userAgent' in d.keys())        || (d.userAgent is string        && d.userAgent.size()        <= 300))
          && (!('source_site' in d.keys())      || (d.source_site is string      && d.source_site.size()      <= 60))
          // which published Privacy Notice this person actually agreed to
          && (!('privacyVersion' in d.keys())   || (d.privacyVersion is string   && d.privacyVersion.size()   <= 20))
          && d.createdAt == request.time;   // server timestamp only; no backdating
    }

    // --- PAAIPE: member profiles ----------------------------------
    // Signing up makes a GUEST. Only PAAIPE confirms someone as an Agent, so a
    // MEMBER may write status only as "guest" and may NEVER change it — without
    // that, anyone could promote themselves to Agent by editing their own
    // profile. Promotion is an ADMINISTRATOR's act, done at /admin under the
    // isAdmin() rule below.
    //
    // agentNumber is likewise not a member's to claim: it is a label PAAIPE
    // issues, writable only by an administrator.
    match /paaipe_agents/{uid} {
      // your own profile, always
      allow read: if request.auth != null && request.auth.uid == uid;
      // the Agent Directory: a signed-in member may read the profiles of
      // CONFIRMED Agents who have opted in, and only those. A guest is never
      // readable by anyone else, whatever they set their own toggle to.
      allow read: if request.auth != null
                  && resource.data.status == 'agent'
                  && resource.data.directoryVisible == true;
      // an administrator sees everyone, including guests awaiting confirmation
      allow read: if isAdmin();

      allow create: if request.auth != null && request.auth.uid == uid
                    && !('agentNumber' in request.resource.data.keys())
                    && request.resource.data.status == 'guest'
                    && request.resource.data.directoryVisible is bool
                    && request.resource.data.email is string
                    && request.resource.data.full_name is string
                    && request.resource.data.full_name.size() <= 120
                    // a profile must carry the consent it was created under
                    && request.resource.data.termsVersion is string
                    && request.resource.data.privacyVersion is string
                    && request.resource.data.consentedAt == request.time;

      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['full_name','updates','directoryVisible','confirmation_seen'])
                    // belt and braces: neither may move even if listed above
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.get('agentNumber', null)
                       == resource.data.get('agentNumber', null)
                    // confirmation is an administrative act: server-only
                    && request.resource.data.get('confirmed_at', null)
                       == resource.data.get('confirmed_at', null)
                    && request.resource.data.get('confirmed_by', null)
                       == resource.data.get('confirmed_by', null);

      // An administrator may confirm a Guest as an Agent, or suspend one, and
      // may do NOTHING else here. They cannot rename a member, flip someone's
      // directory visibility, or rewrite the consent a profile was created
      // under - those belong to the member. Confirmation is stamped with the
      // server's clock and the admin's own email, so it cannot be backdated or
      // attributed to somebody else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','agentNumber','confirmed_at','confirmed_by'])
                    && request.resource.data.status in ['guest','agent','suspended']
                    && (!('agentNumber' in request.resource.data.keys())
                        || (request.resource.data.agentNumber is string
                            && request.resource.data.agentNumber.size() > 0
                            && request.resource.data.agentNumber.size() <= 12))
                    && (request.resource.data.get('confirmed_at', null)
                          == resource.data.get('confirmed_at', null)
                        || request.resource.data.confirmed_at == request.time)
                    && (request.resource.data.get('confirmed_by', null)
                          == resource.data.get('confirmed_by', null)
                        || request.resource.data.confirmed_by == request.auth.token.email);

      allow delete: if false;
    }

    // --- PAAIPE: events, organizations and sponsorships ------------
    //
    // ONE SOURCE OF TRUTH. The public event pages, the registration page, the
    // member portal and the admin console all read these same documents, live.
    // There is no build step and no server: paaipe.org is static, so "change it
    // in admin and it appears everywhere" works by every surface READING the
    // record at runtime rather than by re-rendering and re-deploying. That is
    // simpler than revalidation and it is instant.
    //
    // Because there is no server, anything a visitor's browser can fetch is
    // public. So secrecy has to live in the RULES, not in a render boundary:
    // an unpublished event is unreadable, a sponsorship that is only proposed is
    // unreadable, and the Zoom link is in a separate document (below) that no
    // client may read at all.

    match /paaipe_organizations/{id} {
      // Names, logos and websites are public marketing facts - the Partners page
      // has shown them for months. Only an administrator may change one, and a
      // change here reaches every event that credits the organization.
      allow read: if true;
      allow create, update: if isAdmin()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.status in ['active','inactive'];
      // Deleting an organization would orphan every sponsorship that cites it.
      // Deactivate instead - that is a status, and it keeps the history.
      allow delete: if false;
    }

    match /paaipe_events/{id} {
      // A DRAFT IS NOT PUBLIC. On a static host there is no server to answer 404,
      // so the rule is the boundary: an unpublished event simply cannot be read,
      // and the page says it was not found.
      allow read: if isAdmin() || (resource.data.status is string
                                   && resource.data.status != 'draft');
      allow create, update: if isAdmin()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.slug is string
                    && request.resource.data.slug.matches('^[a-z0-9][a-z0-9-]{0,80}$')
                    && request.resource.data.status in
                         ['draft','published','registration_open','registration_closed','held','cancelled'];
      allow delete: if false;
    }

    // THE ZOOM LINK LIVES HERE, ON ITS OWN.
    //
    // The brief asks that it never leave the server. There is no server, and
    // Firestore rules cannot hide one FIELD of a document - so it is not a field
    // of the event at all. It is a separate record no client may read, which is
    // the closest thing to a server boundary this stack has. Getting it to a
    // registered guest is a mail-sending problem, and mail is not wired yet.
    match /paaipe_event_private/{eventId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /paaipe_event_sponsors/{id} {
      // A PROPOSED sponsorship is a conversation PAAIPE is having, not a fact
      // about the world. Publishing one would announce a partner who has not
      // agreed - the Partners page's own notice forbids exactly that. So only
      // confirmed and delivered rows are readable at all.
      allow read: if isAdmin() || (resource.data.status is string
                                   && resource.data.status in ['confirmed','delivered']);
      allow create, update: if isAdmin()
                    && request.resource.data.eventId is string
                    && request.resource.data.organizationId is string
                    && request.resource.data.tier in ['presenting','supporting','community']
                    && request.resource.data.status in ['proposed','confirmed','delivered'];
      allow delete: if isAdmin();
    }

    // --- PAAIPE: partner applications ------------------------------
    //
    // "Partner with us on this event" is a form ANYONE may submit - a visitor, a
    // Guest, an Agent. So this is the second publicly-writable collection on the
    // site, and like registrations the whole boundary is here.
    //
    // WHAT A SUBMITTER MAY NOT DO, and why each matters:
    //
    //  - They may not CREATE OR TOUCH AN ORGANIZATION. The brief asked that a
    //    submission create or link a paaipe_organizations record. That would
    //    hand every anonymous visitor a write into the collection the public
    //    Partners page and every event credit render from - a name and a logo
    //    on paaipe.org, for free. The match therefore happens in the admin
    //    console, against the live org list, and the org is created when an
    //    administrator ACCEPTS. `paaipe_organizations` stays admin-only above.
    //
    //  - They may not read anybody else's application. A competitor reading who
    //    else is bidding to sponsor the October Exchange is a commercial leak,
    //    and the contact details are personal data (RA 10173). A signed-in
    //    member may read their OWN, which is what the portal's status line
    //    needs; everyone else gets nothing.
    //
    //  - They may not set status, assignment, notes or anything else an
    //    administrator decides. Those keys are simply not allowed on create.
    //
    // NOTE: a conditional read rule cannot filter a list. The portal MUST
    // constrain its query by submittedByUserId or the whole query is refused -
    // see the long note in paaipe-events-data.js.
    match /paaipe_partner_applications/{id} {
      allow create: if isWellFormedPartnerApplication(request.resource.data);

      allow read: if isAdmin()
                  || (request.auth != null
                      && resource.data.get('submittedByUserId', '') == request.auth.uid);

      // An administrator records what HAPPENED to an application and may not
      // rewrite a word the applicant submitted - the same split as
      // registrations. hasOnly() is what enforces it, so no console screen can
      // quietly widen it later.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','assignedTo','adminNote','updated_by','updatedAt',
                                   'organizationId','decidedAt'])
                    && request.resource.data.status in
                         ['new','contacted','in_discussion','accepted','declined','spam']
                    && (!('adminNote' in request.resource.data.keys())
                        || (request.resource.data.adminNote is string
                            && request.resource.data.adminNote.size() <= 2000))
                    && (!('assignedTo' in request.resource.data.keys())
                        || (request.resource.data.assignedTo is string
                            && request.resource.data.assignedTo.size() <= 254))
                    && (request.resource.data.get('updated_by', null)
                          == resource.data.get('updated_by', null)
                        || request.resource.data.updated_by == request.auth.token.email);

      // Somebody offered to help and put their name to it. That is not a record
      // to make disappear - spam is a STATUS, and it keeps the audit trail.
      allow delete: if false;
    }

    function isWellFormedPartnerApplication(d) {
      return d.keys().hasAll(['eventId','reference','companyName','contactName',
                              'email','phone','consentAt','status','createdAt'])
          && d.keys().size() <= 18
          // An application arrives NEW. A submitter cannot pre-accept themselves.
          && d.status == 'new'
          && d.reference is string && d.reference.matches('^PA-20[0-9][0-9]-[0-9A-Z]{4}$')
          && d.eventId      is string && d.eventId.size()      > 0 && d.eventId.size()      <= 120
          && d.companyName  is string && d.companyName.size()   > 0 && d.companyName.size()  <= 160
          && d.contactName  is string && d.contactName.size()   > 0 && d.contactName.size()  <= 120
          && d.email        is string && d.email.size()         > 4 && d.email.size()        <= 254
          && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          // Philippine mobile, normalised to +639XXXXXXXXX before it is sent.
          && d.phone        is string && d.phone.matches('^\\+639[0-9]{9}$')
          && (!('website' in d.keys())      || (d.website is string && d.website.size() <= 300))
          && (!('message' in d.keys())      || (d.message is string && d.message.size() <= 500))
          // A closed list, checked here and not only in the form: these are a
          // FILTER in the console, and a filter over values the client chose is
          // a filter that means nothing.
          && (!('supportTypes' in d.keys())
              || (d.supportTypes is list && d.supportTypes.size() <= 5
                  && d.supportTypes.hasOnly(['speaker','vouchers','venue','media','other'])))
          && (!('source' in d.keys())       || (d.source in ['public_event','events_list','success_page',
                                                             'portal_sessions','portal_session']))
          && (!('eventTitle' in d.keys())   || (d.eventTitle is string && d.eventTitle.size() <= 200))
          && (!('submittedByUserId' in d.keys())
              // You may only claim to be YOURSELF, and only if signed in.
              || (d.submittedByUserId is string
                  && (d.submittedByUserId == '' 
                      || (request.auth != null && d.submittedByUserId == request.auth.uid))))
          && (!('isSample' in d.keys())     || d.isSample is bool)
          && (!('privacyVersion' in d.keys()) || (d.privacyVersion is string && d.privacyVersion.size() <= 20))
          && (!('userAgent' in d.keys())    || (d.userAgent is string && d.userAgent.size() <= 300))
          // Consent is a REQUIRED act with a time on it, stamped by the server.
          && d.consentAt == request.time
          && d.createdAt == request.time;   // server timestamp only; no backdating
    }


    // --- PAAIPE: Learnings (Sessions + Micros) ---------------------
    //
    // Clarence's schema, locked. Two collections — do NOT fold these into
    // paaipe_recordings. Sessions are 16:9 landscape; Micros are 9:16
    // vertical. Portal members may read published rows only; administrators
    // write everything. displayOrder is the portal order.
    //
    // Upload (source == "upload", storagePath, posterStoragePath) is schema-
    // ready. Storage itself is not wired in v1 — the admin UI refuses upload
    // client-side — but the rules still allow an admin to write those fields
    // so flipping LEARNINGS_UPLOAD_STORAGE_READY later needs no rules change.

    function isWellFormedLearning(d) {
      return d.keys().hasAll(['title','source','published','displayOrder','updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.source in ['youtube','upload']
          && d.published is bool
          && d.displayOrder is number
          && (!('description' in d.keys())
              || d.description == null
              || (d.description is string && d.description.size() <= 4000))
          && (!('youtubeUrl' in d.keys())
              || d.youtubeUrl == null
              || (d.youtubeUrl is string && d.youtubeUrl.size() <= 300))
          && (!('youtubeId' in d.keys())
              || d.youtubeId == null
              || (d.youtubeId is string && d.youtubeId.size() <= 20))
          && (!('storagePath' in d.keys())
              || d.storagePath == null
              || (d.storagePath is string && d.storagePath.size() <= 400))
          && (!('posterUrl' in d.keys())
              || d.posterUrl == null
              || (d.posterUrl is string && d.posterUrl.size() <= 400))
          && (!('posterStoragePath' in d.keys())
              || d.posterStoragePath == null
              || (d.posterStoragePath is string && d.posterStoragePath.size() <= 400))
          && (!('updatedBy' in d.keys())
              || d.updatedBy == null
              || (d.updatedBy is string
                  && d.updatedBy == request.auth.token.email));
    }

    match /paaipe_sessions/{id} {
      allow read: if isAdmin()
                  || (resource.data.published == true);
      allow create: if isAdmin() && isWellFormedLearning(request.resource.data);
      allow update: if isAdmin() && isWellFormedLearning(request.resource.data);
      allow delete: if isAdmin();
    }

    match /paaipe_micros/{id} {
      allow read: if isAdmin()
                  || (resource.data.published == true);
      allow create: if isAdmin() && isWellFormedLearning(request.resource.data);
      allow update: if isAdmin() && isWellFormedLearning(request.resource.data);
      allow delete: if isAdmin();
    }

    match /paaipe_recordings/{eventId} {
      // Published recordings only, and only to signed-in members unless the
      // recording says otherwise. Absence means "not published", never "missing".
      allow read: if isAdmin()
                  || (resource.data.publishedAt != null
                      && (resource.data.visibility == 'public'
                          || (request.auth != null && resource.data.visibility in ['members','registrants'])));
      allow write: if isAdmin();
    }

    // --- PAAIPE: event feedback (Clarence, locked) -----------------
    //
    // Two collections. Do not fold questions into the event, into
    // questionsEnabled, or into sessions/micros.
    //
    //   paaipe_event_feedback_questions/{eventId}_{questionKey}
    //   paaipe_event_feedback_responses/{eventId}_{registrationId}
    //
    // Remove a question by active:false so old answers still resolve.
    // A response is created once; create on an existing id is an update and
    // is refused. Public may get/create a response only by that known id —
    // listing the responses collection is administrator-only. Registrations
    // stay unreadable to the submitter (RA 10173); join is decided client-side
    // from a registrationId the new form kept, not by widening those reads.

    function isWellFormedFeedbackQuestion(d) {
      return d.keys().hasAll(['eventId','questionKey','order','prompt','type','required','active'])
          && d.eventId is string && d.eventId.size() > 0 && d.eventId.size() <= 120
          && d.questionKey is string && d.questionKey.size() > 0 && d.questionKey.size() <= 80
          && d.questionKey.matches('^[A-Za-z][A-Za-z0-9_-]{0,79}$')
          && d.prompt is string && d.prompt.size() > 0 && d.prompt.size() <= 200
          && d.type in ['1-5', 'yes-no', 'short']
          && d.required is bool
          && d.active is bool
          && (d.order is int || d.order is float);
    }

    match /paaipe_event_feedback_questions/{id} {
      allow read: if true;
      allow create: if isAdmin()
                    && isWellFormedFeedbackQuestion(request.resource.data)
                    && id == request.resource.data.eventId + '_'
                              + request.resource.data.questionKey;
      allow update: if isAdmin()
                    && isWellFormedFeedbackQuestion(request.resource.data)
                    && request.resource.data.eventId == resource.data.eventId
                    && request.resource.data.questionKey == resource.data.questionKey
                    && id == request.resource.data.eventId + '_'
                              + request.resource.data.questionKey;
      allow delete: if false;
    }

    function isWellFormedFeedbackResponse(d) {
      return d.keys().hasOnly(['eventId','registrationId','submittedAt','answers'])
          && d.eventId is string && d.eventId.size() > 0 && d.eventId.size() <= 120
          && d.registrationId is string && d.registrationId.size() > 0
          && d.registrationId.size() <= 128
          && d.answers is map
          && d.answers.keys().size() <= 20;
    }

    match /paaipe_event_feedback_responses/{id} {
      allow get: if isAdmin() || request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null
                    && isWellFormedFeedbackResponse(request.resource.data)
                    && request.resource.data.submittedAt == request.time
                    && id == request.resource.data.eventId + '_'
                              + request.resource.data.registrationId;
      allow update: if isAdmin()
                    && isWellFormedFeedbackResponse(request.resource.data)
                    && request.resource.data.submittedAt == resource.data.submittedAt
                    && request.resource.data.eventId == resource.data.eventId
                    && request.resource.data.registrationId == resource.data.registrationId;
      allow delete: if false;
    }

    match /paaipe_activity_log/{id} {
      // Who changed what. Append-only: an audit trail that can be edited is not
      // one, so nothing may rewrite or remove an entry, administrators included.
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.at == request.time
                    && request.resource.data.actor == request.auth.token.email;
      allow update, delete: if false;
    }

    // --- PAAIPE: the Agent number counter -------------------------
    // Server-only. No client may read or write it.
    match /paaipe_counters/{doc} {
      allow read, write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
